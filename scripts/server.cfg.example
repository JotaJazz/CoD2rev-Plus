// --- Network ---
// set showpackets 0                           // bool: print every packet
// set showdrop 0                              // bool: print dropped packets
// set packetDebug 0                           // bool
// set net_profile 0                           // int, 0 to 2
// set net_showprofile 0                       // int, 0 to 3
// set net_lanauthorize 0                      // bool: also check the keys of clients on the local network
// set net_altPort 0                           // int, 0 to 65535, applies on the next map or restart: second UDP port of the 1.0 build, announced as 1.3 so the server is listed for both versions; 0 = closed (set it on the command line)
// set net_ip "localhost"                      // string, applies on the next map or restart: local address to bind to
// set net_port 28960                          // int, 0 to 65535, applies on the next map or restart: UDP port
// set net_strictPort 0                        // bool, applies on the next map or restart: 1 = a busy net_port stops the server instead of moving it to one of the next 9 ports (set it on the command line)
// set net_noudp 0                             // bool: disable UDP networking
// set net_noipx 0                             // bool, applies on the next map or restart, Windows only
// set net_socksEnabled 0                      // bool, applies on the next map or restart, Windows only
// set net_socksServer ""                      // string, applies on the next map or restart, Windows only
// set net_socksPort 1080                      // int, 0 to 65535, applies on the next map or restart, Windows only
// set net_socksUsername ""                    // string, applies on the next map or restart, Windows only
// set net_socksPassword ""                    // string, applies on the next map or restart, Windows only

// --- File system ---
// set fs_game ""                              // string, command line only: mod folder
// set fs_debug 0                              // int, 0 to 2: print file system activity
// set fs_copyfiles 0                          // bool, command line only
// set fs_cdpath <set at startup>              // string, command line only: extra read-only game folder
// set fs_basepath <set at startup>            // string, command line only: folder where the game is installed
// set fs_basegame ""                          // string, command line only
// set fs_useOldAssets 0                       // bool
// set fs_homepath <set at startup>            // string, command line only: folder where logs and downloaded files are written
// set fs_restrict 0                           // bool, command line only: restrict the server to demo content
// set fs_ignoreLocalized 0                    // bool, command line only: ignore localized .iwd files

// --- Engine ---
// set dedicated 2                             // int, 1 to 2, command line only: 1 = LAN or direct IP only, 2 = internet (announced to the master servers)
// version                                     // string, read-only: full version string of this build
// shortversion                                // string, read-only: game version of this build
// com_errorMessage                            // string, read-only
// com_errorTitle                              // string, read-only
// set com_maxfps 85                           // int, 0 to 1000: frame rate cap
// set developer 0                             // int, 0 to 2: developer mode: extra console output
// set developer_script 0                      // bool: enable script debugging features
// set logfile 0                               // int, 0 to 2: write the console to logfileName: 0 = off, 1 = buffered, 2 = flushed on every line
// set logfileName ""                          // string: console log file in fs_homepath/<mod>; empty = console_mp_server.log
// set logfileRotate 0                         // int, 0 to 1000: older console logs kept as <name>.1 to <name>.N when the server starts
// set logTimestamps 0                         // bool: start each console log line with the date and time
// set timescale 1.0                           // float, 0.001 to 1000.0, needs sv_cheats 1: game speed multiplier
// set fixedtime 0                             // int, 0 to 1000, needs sv_cheats 1
// set viewlog 0                               // int, 0 to 2, needs sv_cheats 1: show the console window
// sv_paused = 0                               // int, 0 to 2, read-only
// cl_paused = 0                               // int, 0 to 2, read-only
// sv_running = 0                              // bool, read-only: 1 while a map is loaded
// set com_introPlayed 0                       // bool
// set com_animCheck 0                         // bool
// set loc_language 0                          // int, 0 to 13, applies on the next map or restart: language index: 0 English, 1 French, 2 German, 3 Italian, 4 Spanish, 5 British, 6 Russian, 7 Polish
// set loc_forceEnglish 0                      // bool, applies on the next map or restart: always use English strings
// set loc_translate 1                         // bool, applies on the next map or restart
// set loc_warnings 0                          // bool
// set loc_warningsAsErrors 0                  // bool
// set com_hunkMegs 160                        // int, 1 to 512, applies on the next map or restart: megabytes of memory reserved for game data

// --- Platform ---
// arch = "linux i386"                         // string, read-only
// username                                    // string, read-only
// set ttycon 0                                // bool, applies on the next map or restart, Linux only: enable the terminal console
// set in_mouse 1                              // bool, applies on the next map or restart, Windows only
// set sys_cpustring "detect"                  // string, Windows only
// set sys_cpuid <set at startup>              // int, 0 to 2147483647, applies on the next map or restart, Windows only
// set vid_xpos 3                              // int, -4096 to 4096, Windows only
// set vid_ypos 22                             // int, -4096 to 4096, Windows only
// set r_fullscreen 1                          // bool, applies on the next map or restart, Windows only
