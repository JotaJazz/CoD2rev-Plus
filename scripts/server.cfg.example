// Example server configuration for CoD2rev-Plus.
// Copy it to the "main" folder of the game as server.cfg and edit it.
// Do not commit your real server.cfg: it holds passwords.
//
// The first part sets the variables most servers change.
// The second part lists every other variable the server registers, commented
// out and with its default value, so copying this file changes nothing else.
// Remove the leading "//" to use one.
//
// Not listed here: the scr_* variables of each gametype, which are defined by
// the game scripts inside the .iwd files and not by the server.

// =============================================================================
// Common settings
// =============================================================================

// --- Identity ---
set sv_hostname "My CoD2 server"
set sv_maxclients 20            // 1-64, takes effect on the next map load
set sv_privateClients 0         // slots reserved for sv_privatePassword
set sv_privatePassword ""
set g_password ""               // password to join; empty = public

// --- Remote console ---
// Leave rcon_password empty to keep rcon unusable.
set rcon_password ""
set sv_allowRcon 1              // 0 = ignore every rcon packet
set sv_rconMaxAttempts 5        // wrong passwords per IP before the lockout, 0 = no lockout
set sv_rconLockTime 600         // lockout length in seconds
set sv_rconWhitelist ""          // admin IPs never locked out or rate limited, e.g. "203.0.113.5 198.51.100.7"

// --- Master servers (only used with dedicated 2) ---
// sv_master1 defaults to cod2master.activision.com and sv_master2 to master.cod2x.me.
// sv_master2 is set here because the server saves it in config_mp_server.cfg, and a
// file saved by an older build can hold an empty value that overrides the default.
// sv_master3 to sv_master5 are free; host:port is accepted.
set sv_master2 "master.cod2x.me"
set sv_master3 ""
set sv_master4 ""
set sv_master5 ""

// --- Network ---
set sv_fps 20
set sv_maxRate 25000
set sv_minPing 0
set sv_maxPing 0                // 0 = no limit
set sv_timeout 240
set sv_floodProtect 1
set g_antilag 1

// --- Files and downloads ---
set sv_pure 1                   // clients must use the same .iwd files as the server
set sv_allowDownload 1
set sv_wwwDownload 0            // 1 = send clients to sv_wwwBaseURL for downloads
set sv_wwwBaseURL ""

// --- Game ---
set g_gametype "tdm"            // dm, tdm, sd, ctf, hq
set g_allowVote 0
set sv_kickBanTime 300          // seconds a kicked player stays banned
set sv_disableClientConsole 0

// --- Logging ---
set g_log "games_mp.log"
set g_logSync 0

// --- Map rotation ---
// The launcher starts the first map itself; the rotation is used from then on.
set sv_mapRotation "gametype tdm map mp_toujane gametype tdm map mp_carentan gametype tdm map mp_dawnville"

// =============================================================================
// Every other variable (defaults shown)
// =============================================================================
// Notes after each variable:
//   read-only             set by the server, cannot be changed
//   command line only     must be given as "+set name value" when starting
//   needs sv_cheats 1     ignored unless cheats are enabled

// --- Server ---
// set sv_keywords ""                          // string: free text shown to server browsers
// protocol = 115                              // int, read-only: network protocol of this build: 115 = 1.0, 118 = 1.3
// set sv_allowAnonymous 0                     // bool: allow clients flagged as anonymous
// set sv_showCommands 0                       // bool: print every client command to the console
// set sv_voice 0                              // bool: enable in-game voice chat
// set sv_voiceQuality 1                       // int, 0 to 9: voice chat codec quality
// sv_serverid = 0                             // int, read-only: changes on every map load
// sv_iwds                                     // string, read-only: checksums of the loaded .iwd files
// sv_iwdNames                                 // string, read-only: names of the loaded .iwd files
// sv_referencedIwds                           // string, read-only: checksums of the .iwd files the map uses
// sv_referencedIwdNames                       // string, read-only: names of the .iwd files the map uses
// set sv_logRcon 1                            // bool: log the address and command of every accepted rcon command
// set sv_authorizeServer "cod2master.activision.com" // string: server that checks CD keys and gives players their GUID
// set sv_authorizePort 20700                  // int, 1 to 65535: port of sv_authorizeServer
// set g_forceRate 0                           // int, 0 to 25000: rate given to every client, overriding theirs; 0 = their own
// set g_forceSnaps 0                          // int, 0 to 30: snapshots per second given to every client; 0 = their own
// set sv_kickMessages 1                       // bool: tell everyone when a player is kicked
// set sv_timeoutMessages 1                    // bool: tell everyone when a player times out
// set sv_zombietime 2                         // int, 0 to 1800: seconds a disconnected client slot is kept before it is freed
// set sv_reconnectlimit 3                     // int, 0 to 1800: minimum seconds between reconnects from the same address
// set sv_padPackets 0                         // int, 0 or more: add padding bytes to outgoing packets (debugging)
// set sv_allowedClan1 ""                      // string
// set sv_allowedClan2 ""                      // string
// set sv_packet_info 0                        // bool
// set sv_showAverageBPS 0                     // bool
// set sv_mapRotationCurrent ""                // string: remaining part of the rotation, managed by the server
// set sv_debugRate 0                          // bool
// set sv_debugReliableCmds 0                  // bool
// set nextmap ""                              // string: command run when the map ends
// com_expectedHunkUsage = 0                   // int, 0 or more, read-only
// set sv_wwwDlDisconnected 0                  // bool: disconnect clients while they download over HTTP

// --- libcod extensions ---
// set sv_httpAllowedHosts ""                  // string: hosts httpFetch and webSocketConnect may reach (spaces or commas, *.example.com for subdomains); empty = all
// set sv_httpCaFile ""                        // string: PEM file with the certificates https and wss trust; empty = the system's
// set sv_httpAllowPrivate 0                   // bool, command line only: let httpFetch and webSocketConnect reach loopback and private addresses
// set scr_json_max_load_bytes 8388608         // int, 1 to 33554432: largest JSON file json_load and json_load_async read, in bytes
// set scr_json_slow_warn_ms 25                // int, 1 to 60000: a JSON call slower than this many milliseconds prints a warning
// set scr_json_async_max_jobs 64              // int, 1 to 1024: JSON jobs that can run in the background at once
// set sv_master1 "cod2master.activision.com"  // string: first master server
// set fs_library ""                           // string: folder used by the libcod manymaps map download
// set fs_callbacks ""                         // string: script with the CodeCallback_* functions; empty = maps/mp/gametypes/_callbacksetup
// set fs_gametypes ""                         // string: folder of the gametype scripts; empty = maps/mp/gametypes
// set fs_mapScriptDirectories 0               // int, 0 to 2: where a map's main is: 0 maps/mp/<map>, 1 maps/mp/<map>/<map>, 2 that first
// set fs_replaceStockMaps 0                   // bool: let manymaps replace a stock map with a library iwd of the same name
// set loc_loadLocalizedMods 0                 // bool: list the mod's localized iwds for pure clients too
// set g_playerCollision 1                     // bool: players collide with each other
// set g_playerEject 1                         // bool: push apart players stuck inside each other
// set sv_downloadMessage ""                   // string: if set, downloads are refused and this text is shown instead
// set sv_fastDownload 0                       // bool: send in-game downloads faster
// set sv_cracked 0                            // bool: accept clients whatever the key authorization server answers
// set sv_kickbots 0                           // bool: drop bots when the map restarts or changes
// set logErrors 0                             // bool: write script runtime errors to the log without developer mode
// set g_corpseHit 1                           // bool: bullets hit corpses with blood; 0 = as the surface under them
// set g_spectateBots 1                        // bool: let spectators follow bots
// set g_logPickup 1                           // bool: write weapon and item pickups to the game log
// set sv_botKickMessages 1                    // bool: tell everyone when a bot is kicked
// set sv_noAuthorize 0                        // bool: skip the CD key authorization server (players get GUID 0)
// set sv_authorizeTimeout <set at startup>    // int, 0 to 1200000: milliseconds a connecting player waits for the authorization server
// set sv_limitLocalRcon 0                     // bool: apply the rcon rate limit to LAN addresses too
// set sv_isLookingAtOnDemand 0                // bool: trace what players look at only for isLookingAt (no crosshair names or trigger_lookat)
// set sv_fastDownloadSpeed <set at startup>   // int, 1 to MAX_DOWNLOAD_WINDOW: messages a frame sv_fastDownload sends a downloading client
// set g_ambientSound 1                        // bool: play the map's distant battle sounds (ambientPlay)
// set g_fireFx 1                              // bool: send the map's looped fx/fire/ effects and fire sounds
// set g_smokeFx 1                             // bool: send the map's looped fx/smoke/ effects
// set g_weatherFx 1                           // bool: send the map's looped dust, snow and fog bank effects
// set g_fog 1                                 // bool: let map scripts set fog (setExpFog, setCullFog)
// set sv_libcodUnsafe 0                       // bool, command line only: let scripts use the libcod functions that reach the shell, raw memory, any file or any address
// set jump_bounceEnable 0                     // bool, needs sv_cheats 1: keep speed when landing on slopes (bouncing)
// set g_mantleBlockEnable 1                   // bool
// set g_fixedWeaponSpreads 0                  // bool: use a fixed spread pattern instead of random spread
// set g_dropGrenadeOnDeath 1                  // bool: a player killed while holding a primed grenade drops it
// set sv_botUseTriggerUse 0                   // bool: send bots a "bot_trigger" notify for the use triggers they stand in
// set g_bulletDrop 0                          // bool: let enableBulletDrop give a player's bullets travel time and drop
// set g_bulletDropMaxTime 10000               // int, 50 to 60000: milliseconds a dropping bullet flies before it is dropped
// set g_debugGraph 0                          // bool: print debug messages from the graph (A*) script functions
// set sv_graphAstarMaxIterations 0            // int, 0 to 100000: maximum nodes expanded by one graphFindPath; 0 = no limit
// set sv_graphAstarWeight 1.0                 // float, 1.0 to 2.0: A* heuristic weight; above 1 finds paths faster but less short
// set sv_graphMaxGraphs 8                     // int, 1 to 64: maximum number of graphs scripts can create
// set sv_graphMaxNodes 16384                  // int, 64 to 65535: maximum nodes in one graph
// set g_reservedModels 0                      // int, 0 to 255, applies on the next map or restart: model slots kept for script precaches, out of reach of map entities
// set g_safePrecache 0                        // bool, applies on the next map or restart: warn and show a default model or effect instead of stopping the map on precache overflows
// set sv_minimizeSysteminfo 0                 // int, 0 to 3, applies on the next map or restart: move some dvars from the systeminfo to the gamestate, to make room for more iwds
// set g_noMoverBlockage 0                     // bool: let movers go on when an entity blocks them
// set g_spawnMapWeapons 1                     // bool: spawn the map's weapons; 0 hands them to CodeCallback_MapWeaponsLoad
// set g_spawnMapTurrets 1                     // bool: spawn the map's turrets; 0 hands them to CodeCallback_MapTurretsLoad

